+  // bench opt4：鼠标在 workspace 行停留 150ms 后提前发起 readWorkspacePresentation 预热
+  // （幂等、host 有缓存），把冷 workspace 的 agent 启动从点击后提前到悬停期间，
+  // 缩短点击到内容可见的等待。快速划过（<150ms 离开）不触发；每个挂载只预热一次。
+  const prewarmFiredRef = useRef(false);
+  const prewarmTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+  useEffect(
+    () => () => {
+      if (prewarmTimerRef.current) {
+        clearTimeout(prewarmTimerRef.current);
+      }
+    },
+    [],
+  );
+  const handleWorkspaceRowMouseEnter = useCallback(() => {
+    setWorkspaceRowHovered(true);
+    if (prewarmFiredRef.current || tab.remoteSessionId || isDisconnectedRemoteWorkspace) {
+      return;
+    }
+    prewarmTimerRef.current = setTimeout(() => {
+      prewarmFiredRef.current = true;
+      void services.zcodeSessionService
+        .readWorkspacePresentation({
+          workspacePath: tab.workspacePath,
+          ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+        })
+        .catch(() => {
+          /* 预热失败不提示；真正进入 workspace 时会重试并展示错误。 */
+        });
+    }, 150);
+  }, [
+    isDisconnectedRemoteWorkspace,
+    services.zcodeSessionService,
+    tab.remoteSessionId,
+    tab.workspaceIdentity,
+    tab.workspacePath,
+  ]);
+  const handleWorkspaceRowMouseLeave = useCallback(() => {
+    setWorkspaceRowHovered(false);
+    if (prewarmTimerRef.current) {
+      clearTimeout(prewarmTimerRef.current);
+      prewarmTimerRef.current = null;
+    }
+  }, []);
