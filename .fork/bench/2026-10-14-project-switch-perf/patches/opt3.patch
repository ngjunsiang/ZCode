+            .catch((error: unknown) => {
+              logger.error(
+                `[App] 释放 workspace 预热态失败 workspace=${workspaceAbsPath} provider=${provider}:`,
+                error,
+              );
+            });
+        }, WORKSPACE_PREPARATION_RELEASE_DELAY_MS),
+      );
     };
   }, [services.zcodeTaskService, workspaceIdentity, workspaceAbsPath]);
 }
